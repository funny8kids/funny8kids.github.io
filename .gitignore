# Local tooling / workspace artifacts
.playwright-mcp/
.zcode/
.worktrees/

# Art-panel working notes: they name the source franchise by title, and a static host would publish them
# (there is no .nojekyll, so a committed .md is rendered into a fetchable HTML page). Evidence stays
# in the local chain, never in the shipped tree.
AWWWARDS-PANEL-*.md

# Same rule for the rest of the local judgement chain and the instruments that produce it: the scorecard,
# submission draft, gate screenshots and scratch output all name the homage and carry unreleased frames.
AWWWARDS-SCORECARD.md
AWWWARDS-SUBMISSION.md
AWWWARDS-EVIDENCE-*.md
/shots/
/vibe_images/
/.playwright-cli/
/.workbuddy/
*.log

# Blender and Python backups of the modelling pipeline: authoring state, not shipped bytes.
__pycache__/
*.pyc
*.blend1
*.blend.bak-*

# The delivered figure source: 92.5 MB, 1.47 M triangles and three 4096^2 PNGs. A static host has no
# business carrying it, and pipeline/vc_bake_source.cjs reads it to start the chain that ends as
# assets/models/VioletHero.glb (see the comment in pipeline/compress.sh for the whole route), so it is
# authoring input like a .blend and stays out of the tree.
/violet.glb

# Candidate cuts for the re-cut sweep, served so the site-camera gates can name the file they graded
# (?fig=_sweep/...). Scratch output, never shipped.
/_sweep/
